{
  "name": "@mbsks/side-pigeon",
  "version": "0.1.0",
  "description": "side-pigeon — headless client for the side-pigeon Rust sidecar (Telegram, Discord, ... via JSON-RPC 2.0 over stdio)",
  "keywords": [
    "ai-agent",
    "discord",
    "json-rpc",
    "messaging",
    "pigeon",
    "sidecar",
    "telegram"
  ],
  "license": "MIT",
  "author": "Saurav Sanjel <master8848@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/master8848/side-pigeon.git"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ffi": {
      "types": "./src/ffi.ts",
      "import": "./src/ffi.ts"
    }
  },
  "optionalDependencies": {
    "koffi": "^2.8",
    "ffi-napi": "^4.0.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  }
}
